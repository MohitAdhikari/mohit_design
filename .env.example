# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_READ_TOKEN="optional_token_for_drafts"
SANITY_API_WRITE_TOKEN="token_with_write_access"

# Live draft preview (use the same value for both)
NEXT_PUBLIC_SANITY_PREVIEW_SECRET="your-preview-secret"
SANITY_PREVIEW_SECRET="your-preview-secret"

# Email notifications (choose one provider)
ADMIN_EMAIL="phoneoceanlive@gmail.com"
EMAIL_FROM="PhoneOcean <no-reply@phoneocean.in>"
RESEND_API_KEY="re_..."
# SENDGRID_API_KEY="SG..."
# EMAIL_WEBHOOK_URL="https://..."

# Analytics and SEO
NEXT_PUBLIC_SITE_URL="https://phoneocean.in"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your_google_site_verification_code"
